# Server Environment Configuration Template
# For Local Development:
PORT=3000
MONGO_CONN=mongodb://127.0.0.1:27017/studx
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173,http://localhost:3000
NODE_ENV=development

# For Production (Render Web Service):
# PORT will be automatically assigned by Render (e.g. 10000)
# MONGO_CONN=mongodb+srv://<username>:<password>@cluster.mongodb.net/studx?retryWrites=true&w=majority
# JWT_SECRET=strong_random_production_secret
# CLIENT_URL=https://your-frontend.vercel.app
# NODE_ENV=production
